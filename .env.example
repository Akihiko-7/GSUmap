# Google AI Studio key (https://aistudio.google.com/apikey). Without it the app still works: search falls back to local rules.
GEMINI_API_KEY=
# Optional: force a model id instead of picking the best Gemma 4 one at startup
GEMMA_MODEL=
# PIN for the Add/Update place mode. Leave empty to turn admin mode off.
ADMIN_PIN=
# Seconds before an AI call gives up
AI_TIMEOUT=30
